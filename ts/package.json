{
  "name": "@urh/ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client and tooling for the Upper-Right Harness",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
